# Server-only API origin. Run the actual API on a different port than Next.js.
# Backend API_ORIGIN must match your FRONTEND origin, e.g. http://localhost:3000.
ORRYN_API_URL=http://127.0.0.1:3001

# Browser-visible RPC. Use only a public endpoint with no private API keys.
# Leave empty until you have selected the intended settlement network.
NEXT_PUBLIC_ARC_RPC_URL=
NEXT_PUBLIC_ARC_CHAIN_ID=
