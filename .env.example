# Copy to ignored .env.local; replace placeholders. No signing/deployer key belongs here.
PATCHBOND_MODE=local
NETWORK_MANIFEST=config/networks/runtime.local.example.json
SEPOLIA_RPC_URL=http://127.0.0.1:8545
ARC_TESTNET_RPC_URL=http://127.0.0.1:8546
DATABASE_URL=postgresql://patchbond:replace-me@127.0.0.1:5432/patchbond
API_ORIGIN=http://localhost:3000
API_PORT=3000
# Set the actual verifier public address. No default signer identity is invented.
EVALUATOR_ADDRESS=
ARTIFACT_BACKEND=filesystem
ARTIFACT_DIRECTORY=/tmp/patchbond-artifacts
# For testnet mode, use S3 and provide credentials privately through AWS_* or an IAM role.
# ARTIFACT_BACKEND=s3
# ARTIFACT_BUCKET=
# ARTIFACT_REGION=
# ARTIFACT_ENDPOINT=
# Operational limits (defaults shown; all validated and bounded)
MAX_ACTIVE_RUNS=5
MAX_INVENTORY=20
MAX_BODY_BYTES=262144
LEASE_SECONDS=60
MAX_ATTEMPTS=3
SESSION_SECONDS=3600
CHALLENGE_SECONDS=300
REQUESTS_PER_MINUTE=60
GLOBAL_REQUESTS_PER_MINUTE=600
MAX_ARTIFACT_BYTES=1048576

# Comma-separated exact IPs of your controlled reverse proxies; empty trusts none.
TRUSTED_PROXY_IPS=

# Worker only: dedicated UNFUNDED evaluator key in a private 0600 file, not a participant wallet.
# Never put the private key value in this file or Git. The API does not load the file.
VERIFIER_KEY_FILE=
WORKER_RUN_TIMEOUT_MS=180000
